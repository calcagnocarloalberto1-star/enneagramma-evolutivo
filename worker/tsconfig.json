{
  "include": ["./**/*.ts", "../shared/**/*.ts"],
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "target": "ES2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "baseUrl": "..",
    "paths": {
      "@shared/*": ["./shared/*"]
    }
  }
}
